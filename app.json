{
  "expo": {
    "name": "相册管家 · Photomanager",
    "slug": "photomanager",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F4F7F5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.weiwei.photoswipe",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#F4F7F5"
      },
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_MEDIA_LOCATION",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "允许相册管家访问您的照片以进行滑动整理与分类",
          "savePhotosPermission": "允许相册管家将照片归档至指定相册",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
