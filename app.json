{
  "expo": {
    "name": "PhotoSwipe",
    "slug": "photoswipe",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F5F8F6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.weiwei.photoswipe",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#F5F8F6"
      },
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_MEDIA_LOCATION",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "允许 PhotoSwipe 访问您的照片以进行滑动整理与分类",
          "savePhotosPermission": "允许 PhotoSwipe 将照片归档至指定相册"
        }
      ]
    ]
  }
}
